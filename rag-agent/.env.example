# Stage 1 secret 관리 예시 파일
# 이 파일을 `.env` 로 복사해서 로컬 값을 채워 사용한다.

APP_ENV=development
APP_TITLE=RAG Agent Minimal API
APP_DESCRIPTION=문서/임베딩/LLM/RAG/Agent/API를 한 파일에 담은 최소 학습용 서비스
APP_VERSION=0.1.0

#GEMINI_API_KEY=your-gemini-api-key
#GEMINI_MODEL=gemini-2.5-flash
#GEMINI_EMBED_MODEL=models/gemini-embedding-001


INTERNAL_API_SECRET=change-this-internal-secret
PASSWORD_PEPPER=change-this-password-pepper
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user1234
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin1234
AUTH_TOKEN_EXPIRE_SECONDS=3600